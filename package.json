{
  "name": "@axiomantic/garden",
  "version": "0.2.26",
  "description": "Multi-Agent Swarm Orchestration, Empirical Dialectics & Ceremonies on top of Rhizo & Vine",
  "main": "bin/run.js",
  "bin": {
    "garden": "bin/run.js",
    "rhizo": "bin/rhizo.js",
    "vine": "bin/vine.js",
    "rift": "bin/rift.js"
  },
  "skills": "./skills",
  "files": [
    "bin/run.js",
    "bin/rhizo.js",
    "bin/vine.js",
    "bin/rift.js",
    "bin/binaries/",
    "scripts/",
    "skills/",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axiomantic/garden.git"
  },
  "scripts": {
    "test": "nim c -r tests/test_garden.nim && nim c -r tests/test_seed.nim && nim c -r tests/test_germinate.nim && nim c -r tests/test_roadmap.nim && nim c -r tests/test_update.nim && node tests/test_riders.js",
    "build": "nim c -d:release --threads:on --mm:orc -o:bin/garden src/garden.nim"
  },
  "keywords": [
    "multi-agent",
    "ai-agents",
    "orchestration",
    "dialectics",
    "rhizo",
    "vine",
    "garden",
    "swarm"
  ],
  "author": "Axiomantic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/axiomantic/garden/issues"
  },
  "homepage": "https://github.com/axiomantic/garden#readme",
  "dependencies": {
    "@axiomantic/rhizo": "^0.2.28",
    "@axiomantic/vine": "^0.2.16",
    "rift-snapshot": "^0.0.13"
  }
}
